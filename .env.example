# ---------------------------------------------------------------------------
# Configuración para docker compose.
#
#   cp .env.example .env
#   docker compose up
#
# Los valores de abajo son de desarrollo y sirven para arrancar el proyecto sin
# dar de alta nada en ningún servicio externo. No hay ningún valor por defecto
# dentro del código: si falta una variable, la aplicación se niega a arrancar y
# dice cuál. Es deliberado — un arranque con un secreto por defecto conocido es
# peor que un arranque fallido, porque nadie se entera.
#
# Para cualquier despliegue real hay que sustituirlos todos, empezando por
# JWT_SECRET: con el de aquí, cualquiera que lea este fichero puede firmarse un
# token de gerencia.
# ---------------------------------------------------------------------------

# --- Base de datos -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=cinema-local
MYSQL_DATABASE=cinema
DB_URL=jdbc:mysql://db:3306/cinema?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASS=cinema-local

# --- JWT ---------------------------------------------------------------------
# Mínimo 32 bytes o la aplicación no arranca.
# Genera uno nuevo con:  openssl rand -base64 48
JWT_SECRET=dev-only-no-usar-en-produccion-cambialo-antes-de-despleg4r-xyz
JWT_EXPIRATION=86400000

# --- CORS --------------------------------------------------------------------
# Lista blanca de orígenes del frontend, separados por comas. "*" está
# prohibido: es incompatible con credenciales y la aplicación lo rechaza.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8081

# --- Cloudinary (imágenes de películas y perfiles) ---------------------------
# https://cloudinary.com/console — con estos valores la subida de imágenes
# falla, pero el resto de la aplicación funciona.
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=dev-only-cloudinary-secret

# --- Correo (confirmaciones de compra y bienvenida) --------------------------
# Con estos valores el envío falla y se registra en el log sin tumbar la
# operación. Con Gmail usa una App Password, nunca la contraseña de la cuenta.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dev@localhost
MAIL_PASSWORD=dev-only-mail-password
MAIL_FROM=no-reply@lumencinema.local

# --- Stripe (modo test) ------------------------------------------------------
# https://dashboard.stripe.com/test/apikeys — claves de prueba, gratuitas.
# Con los valores de abajo el pago no llega a Stripe; el resto sí funciona.
STRIPE_SECRET_KEY=sk_test_dev_only
STRIPE_PUBLISHABLE_KEY=pk_test_dev_only
STRIPE_WEBHOOK_SECRET=whsec_dev_only
